{
  "name": "bytnode-ai",
  "version": "0.1.4",
  "description": "Local AI finance agents: professions, tools, BytNode market data, models by OpenRouter key or by subscription (ACP).",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "BytNode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjfrem07/bytnode-ai.git"
  },
  "bin": {
    "bytnode-ai": "bin/bytnode-ai.mjs"
  },
  "main": "dist-desktop/app/main.cjs",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "bin",
    ".next",
    "lib",
    "!lib/**/*.test.ts",
    "!lib/**/test-fixture.ts",
    "!.next/dev",
    "!.next/cache",
    "!.next/trace",
    "!.next/trace-build",
    "!.next/types",
    "!.next/diagnostics",
    "!.next/**/*.map",
    "!.next/**/*.nft.json",
    "professions",
    "types",
    "tsconfig.json",
    "next.config.ts",
    "proxy.ts"
  ],
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3777",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3777",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "tsx scripts/next-version.ts",
    "prepack": "tsx scripts/prepack.ts",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "vierge": "node scripts/vierge.mjs",
    "desktop": "tsx scripts/desktop.ts run",
    "desktop:dir": "tsx scripts/desktop.ts dir",
    "desktop:dist": "tsx scripts/desktop.ts dist"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vscode/ripgrep": "^1.18.0",
    "ccxt": "^4.5.78",
    "electron-updater": "^6.8.9",
    "fast-glob": "^3.3.3",
    "next": "16.3.5",
    "pdf-parse": "^2.4.5",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.13",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

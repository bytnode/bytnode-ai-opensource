{
  "name": "bytnode-ai",
  "version": "0.1.1",
  "description": "Des agents IA financiers, en local : professions, outils, donnees de marche BytNode, modeles par cle OpenRouter ou par abonnement (ACP).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjfrem07/bytnode-ai.git"
  },
  "bin": {
    "bytnode-ai": "bin/bytnode-ai.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "files": [
    "bin",
    ".next",
    "lib",
    "!lib/**/*.test.ts",
    "!lib/**/test-fixture.ts",
    "professions",
    "types",
    "tsconfig.json",
    "next.config.ts",
    "proxy.ts"
  ],
  "scripts": {
    "dev": "next dev --port 3777",
    "build": "next build",
    "start": "next start --port 3777",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "tsx scripts/prepack.ts",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "vierge": "node scripts/vierge.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vscode/ripgrep": "^1.18.0",
    "ccxt": "^4.5.78",
    "fast-glob": "^3.3.3",
    "next": "^16.2.6",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.13",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
